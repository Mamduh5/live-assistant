{
  "name": "live-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first, platform-neutral livestream event pipeline.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/cli.js",
    "demo": "node src/cli.js --scenario mixed-burst",
    "dashboard": "node src/cli.js --dashboard",
    "dashboard:ai-fixture": "node scripts/ai-dashboard-fixture.js",
    "check": "node scripts/check-syntax.js",
    "test": "node --test --experimental-test-isolation=none",
    "validate": "npm run check && npm test"
  },
  "dependencies": {
    "protobufjs": "^8.7.2"
  }
}
